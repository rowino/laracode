{
    "watch": {
        "paths": [
            "app",
            "config",
            "resources",
            "tests"
        ],
        "searchWord": "@claude",
        "stopWord": "claude!",
        "mode": "interactive",
        "excludePatterns": [
            "**/vendor/**",
            "**/node_modules/**",
            "**/storage/**",
            "**/.git/**",
            "**/.idea/**",
            "**/.vscode/**",
            "**/bootstrap/cache/**",
            "**/*.log",
            "**/.DS_Store"
        ]
    },
    "testing": {
        "commands": [
            "composer test",
            "composer checks"
        ]
    },
    "linting": {
        "commands": [
            "composer lint",
            "composer phpstan"
        ]
    },
    "worktrees": {
        "defaultSourceBranch": "master"
    },
    "defaultMode": "yolo"
}
